# Copy to .env and fill in. NEVER commit .env.
# API key (OpenAI-compatible gateway, or a vendor key):
API_KEY=sk-your-key-here

# OpenAI-compatible gateway base URL (change to switch vendors/providers):
BASE_URL=https://api.openai.com/v1

# Model name (model layering: dev/interactive uses the cheap tier, the eval
# harness uses EVAL_MODEL — the strong tier. Unset EVAL_MODEL to reuse MODEL):
MODEL=gpt-4o-mini
EVAL_MODEL=

# Allow agent to work only inside this directory (absolute or relative to repo root):
WORKDIR=.

# Agent loop / termination limits:
MAX_STEPS=25
MAX_TOOL_CALLS=50
COMMAND_TIMEOUT=60
OUTPUT_CAP_CHARS=8000
MAX_CONSECUTIVE_FAILURES=3
NO_PROGRESS_LIMIT=3
MAX_ELAPSED_S=600
