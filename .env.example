# Copy to .env and fill in. NEVER commit .env.
# API key (OpenAI-compatible gateway, or a vendor key):
API_KEY=sk-your-key-here

# OpenAI-compatible gateway base URL (change to switch vendors/providers):
BASE_URL=https://api.openai.com/v1

# Model name (model layering: dev/interactive uses the cheap tier, the eval
# harness uses EVAL_MODEL — the strong tier. Unset EVAL_MODEL to reuse MODEL):
MODEL=gpt-4o-mini
EVAL_MODEL=

# Allow agent to work only inside this directory (absolute or relative to repo root):
WORKDIR=.

# Agent loop / termination limits:
MAX_STEPS=25
MAX_TOOL_CALLS=50
COMMAND_TIMEOUT=60
OUTPUT_CAP_CHARS=8000
MAX_CONSECUTIVE_FAILURES=3
NO_PROGRESS_LIMIT=3
MAX_ELAPSED_S=600
# Auto-compaction is ON by default (Claude Code's auto-compact window): when the
# conversation's estimated history exceeds this, it is summarized. 0 disables.
AUTO_COMPACT_AT_TOKENS=60000
# Token budget cap (AgentBudget-style): stop a runaway loop past this many
# session tokens. 0 disables.
MAX_TOTAL_TOKENS=0
# Aider-style repo map: inject a compact codebase symbol map into agent context
CODE_MAP=1
CODE_MAP_CHARS=4000
# Persistent project context (CLAUDE.md-style): read <workdir>/AGENT.md + PM_PROFILE.md
AGENT_MD=1
AGENT_MD_CHARS=2000
# Multi-agent explore subagent (gated — off by default; never spawned unless needed)
#   off (default) | auto (only when repo is large/complex) | always
AUTO_EXPLORE=off
EXPLORE_MIN_FILES=200
EXPLORE_MIN_LOC=20000
EXPLORE_MIN_MODULES=6
EXPLORE_MODEL=
EXPLORE_MAX_STEPS=6
EXPLORE_BRIEF_CHARS=1500
# Phase B: cheap planner (brief+task -> todo) and parallel exploration fan-out
#   off (default) | auto | always
AUTO_PLAN=off
PARALLEL_EXPLORE=off
EXPLORE_FANOUT_MIN_MODULES=8
